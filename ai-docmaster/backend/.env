# ── Application ────────────────────────────────────────────────────────────────
APP_NAME=AI DocMaster
APP_VERSION=1.0.0
DEBUG=True
SECRET_KEY=ai-docmaster-super-secret-key-change-in-production-2024
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Database ───────────────────────────────────────────────────────────────────
# For local dev without Docker:
DATABASE_URL=postgresql+asyncpg://postgres:root@localhost:5432/ai_docmaster
SYNC_DATABASE_URL=postgresql://postgres:root@localhost:5432/ai_docmaster
# For Docker Compose (uncomment these and comment above):
# DATABASE_URL=postgresql+asyncpg://postgres:password@db:5432/ai_docmaster
# SYNC_DATABASE_URL=postgresql://postgres:password@db:5432/ai_docmaster

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
# For Docker: REDIS_URL=redis://redis:6379/0

# ── AI / LLM ───────────────────────────────────────────────────────────────────
# Add your API key here. If left blank, the app uses mock responses so you can
# test all UI flows without a paid API key.
OPENAI_API_KEY=
GEMINI_API_KEY=
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# ── Vector Database ────────────────────────────────────────────────────────────
VECTOR_DB=chromadb
CHROMA_PERSIST_DIR=./data/chroma
FAISS_INDEX_PATH=./data/faiss

# ── File Storage ───────────────────────────────────────────────────────────────
STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=20

# ── CORS ───────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
