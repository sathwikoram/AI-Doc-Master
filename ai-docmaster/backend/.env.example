# ── Application ────────────────────────────────────────────────────────────────
APP_NAME="AI DocMaster"
APP_VERSION="1.0.0"
DEBUG=True
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/ai_docmaster
SYNC_DATABASE_URL=postgresql://postgres:password@localhost:5432/ai_docmaster

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── AI / LLM ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-key
GEMINI_API_KEY=your-gemini-key
LLM_PROVIDER=openai          # openai | gemini | local
LLM_MODEL=gpt-4o-mini

# ── Vector Database ────────────────────────────────────────────────────────────
VECTOR_DB=chromadb           # chromadb | faiss
CHROMA_PERSIST_DIR=./data/chroma
FAISS_INDEX_PATH=./data/faiss

# ── File Storage ───────────────────────────────────────────────────────────────
STORAGE_PROVIDER=local       # local | cloudinary
UPLOAD_DIR=./uploads
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
MAX_FILE_SIZE_MB=20

# ── Email ──────────────────────────────────────────────────────────────────────
MAIL_USERNAME=your@email.com
MAIL_PASSWORD=your-mail-password
MAIL_FROM=noreply@aidocmaster.com
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_STARTTLS=True
MAIL_SSL_TLS=False

# ── CORS ───────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
